# Bulk spectra downloaded from archives — regenerate with scripts/fetch_ngsl.sh.
# The spectra of the SELECTED stars are tracked (4 x 53 KB) so the analysis can
# be reproduced without a 22 MB refetch; the other 375 are not.
data/spectra/*
!data/spectra/h_stis_ngsl_hd194453_v2.fits
!data/spectra/h_stis_ngsl_hd040573_v2.fits
!data/spectra/h_stis_ngsl_hd128801_v2.fits
!data/spectra/h_stis_ngsl_hd143459_v2.fits
data/stis_ngsl_v2.zip

# Pickles template spectra (131 files, ~3 MB); the README, the index table and
# the derived catalog are tracked, the spectra themselves are refetchable.
data/pickles/*.fits
!data/pickles/pickles_index.fits

# UVES-POP spectra (~2.9 MB each). The four SELECTED stars are tracked
# (11.5 MB total); anything else fetched for screening is not.
# URLs in scripts/uves_pop_astars.py.
data/uves_pop/*
!data/uves_pop/Castor.fits.gz
!data/uves_pop/HD162393.fits.gz
!data/uves_pop/HD162678.fits.gz
!data/uves_pop/HD188294.fits.gz

# XSL DR3: the 772 MB full-release tarball is refetchable (data/xsl/fetch.sh);
# the extracted spectra of the selected stars are tracked by name, as for NGSL.
data/xsl/*.tar
data/xsl/*.log
data/xsl/XSL_DR3_release/*
!data/xsl/XSL_DR3_release/xsl_spectrum_X0196_merged.fits
!data/xsl/XSL_DR3_release/xsl_spectrum_X0243_merged.fits
!data/xsl/XSL_DR3_release/xsl_spectrum_X0245_merged.fits
!data/xsl/XSL_DR3_release/xsl_spectrum_X0288_merged.fits
!data/xsl/XSL_DR3_release/xsl_spectrum_X0386_merged.fits

# ATLAS12 output: atmospheres, synthesized spectra, logs, and the 25 GB model
# grid. All of it is regenerable (grid/build_grid.py, grid/make_model.py), so
# ignore models/ wholesale and allow back only the small driver scripts.
# Ignoring by directory name was NOT enough: models/grid/ appeared later and was
# swept into a commit because the rules named models/work/ specifically.
models/*
!models/*.sh

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store
