# Bulk spectra downloaded from archives — regenerate with scripts/fetch_ngsl.sh
data/spectra/
data/stis_ngsl_v2.zip

# Pickles template spectra (131 files, ~3 MB); the README, the index table and
# the derived catalog are tracked, the spectra themselves are refetchable.
data/pickles/*.fits
!data/pickles/pickles_index.fits

# UVES-POP spectra (~3 MB each) — refetchable, URLs in scripts/uves_pop_astars.py.
# The derived catalogs (uves_pop_*.csv) ARE tracked.
data/uves_pop/

# ATLAS12 output: atmospheres, synthesized spectra, logs (113 MB).
# Regenerate with scripts/make_atlas_model.py; the driver scripts are tracked.
models/work/
models/*.log
models/*_R10000.csv

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store
